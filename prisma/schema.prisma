// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 食物類別列舉
model FoodDictionary {
  id        String   @id @default(uuid())
  label     String   @unique // 食物名稱
  type      FoodType // 判定出來的食物類別
  createdAt DateTime @default(now())

  @@index([label])
}

enum FoodType {
  FIBER
  PROTEIN
  COMPLEX_CARB
  SIMPLE_CARB
  OTHER
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  password      String?        // bcrypt hash；null = 由 meals endpoint 自動建立、尚未完成註冊的帳號
  records       MealRecord[]
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(512)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model MealRecord {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  totalScore  Int        // 該餐點的總分數
  tips        Json?      // 儲存產生的衛教建議 (字串陣列)
  recordedAt  DateTime   @default(now()) // 紀錄時間
  
  foodItems   FoodItem[] // 一對多：一筆紀錄包含多個食物品項 (代表進食序列)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, recordedAt]) // 建立複合索引：優化高頻的「特定使用者」與「時間範圍」查詢
}

model FoodItem {
  id            String     @id @default(uuid())
  mealRecordId  String
  mealRecord    MealRecord @relation(fields: [mealRecordId], references: [id], onDelete: Cascade)
  
  type          FoodType   // 食物類別
  label         String     // 食物名稱
  sequenceIndex Int        // 進食順序

  createdAt     DateTime   @default(now())

  @@index([mealRecordId]) // 幫助快速拉取某筆紀錄的所有食物品項
}
